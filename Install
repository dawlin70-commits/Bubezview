#!/usr/bin/env bash
# ==============================================================================
# INSTALLATORE STANDALONE C++ / CMAKE
# Generato da Release Studio
# ==============================================================================

set -e

APP_ID="bubezview"
APP_NAME="Bubezview"
PROJECT_URL="https://dawlinshare.web.app/versioni.json"
TARGET_EXE="bubezview"
ICON_NAME="bubezview_icon.jpg"
APP_CATEGORY="Utility"

RELEASE_PUBKEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAfr3yn0QMgvYvEjW+fkfKAF8ZP4EWsn9DOrhtjHPEe1I=
-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# 1. RILEVAMENTO INTERFACCIA (GUI o TERMINALE)
# ------------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

UI_MODE="cli"
FORCE_CLI=0
VERBOSE=0
IS_UPDATE=0
ACTION=""
PURGE=0
TARGET_COMPONENT=""
CUSTOM_GIT_URL=""
CUSTOM_GIT_BRANCH=""
CUSTOM_BUILD_FLAGS=""
EXTRA_CMAKE_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --cli|-c)
            FORCE_CLI=1
            ;;
        --update|-u|--yes|-y)
            IS_UPDATE=1
            FORCE_CLI=1
            ;;
        --verbose|-v)
            VERBOSE=1
            ;;
        --build-component)
            FORCE_CLI=1
            ;;
        --uninstall)
            ACTION="uninstall"
            FORCE_CLI=1
            ;;
        --purge)
            PURGE=1
            ;;
        --clean)
            ACTION="clean"
            FORCE_CLI=1
            ;;
        --reinstall)
            ACTION="reinstall"
            FORCE_CLI=1
            ;;
        --doctor|--status)
            ACTION="doctor"
            FORCE_CLI=1
            ;;
        --reset-config)
            ACTION="reset"
            FORCE_CLI=1
            ;;
        --help|-h)
            echo "Uso: ./Install [opzioni]"
            echo ""
            echo "Opzioni principali:"
            echo "  (nessun argomento)     Avvia il menu grafico interattivo (se presente interfaccia)"
            echo "  --cli, -c              Esegui in modalità terminale (senza dialoghi grafici)"
            echo "  --update, -u, -y       Esegui installazione o aggiornamento non interattivo"
            echo "  --reinstall            Pulisci cache di build e reinstalla da zero"
            echo "  --clean                Pulisci i file e le cartelle temporanee di compilazione"
            echo "  --doctor, --status     Verifica stato, motori, librerie e dipendenze di sistema"
            echo "  --reset-config         Ripristina le impostazioni predefinite di fabbrica"
            echo "  --uninstall [--purge]  Disinstalla BubezView dal sistema (con --purge rimuove anche config e cache)"
            echo "  --build-component <N>  Compila un singolo modulo da sorgente (poppler, libarchive, 7zip, qpdf, tesseract)"
            echo "  --verbose, -v          Output dettagliato"
            echo "  -h, --help             Mostra questo messaggio di aiuto"
            exit 0
            ;;
    esac
done

if [ "$FORCE_CLI" -eq 0 ] && ([ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]); then
    if command -v zenity >/dev/null 2>&1; then
        UI_MODE="zenity"
    elif command -v kdialog >/dev/null 2>&1; then
        UI_MODE="kdialog"
    elif command -v yad >/dev/null 2>&1; then
        UI_MODE="yad"
    fi
fi

RED="\033[0;31m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
YELLOW="\033[1;33m"
BOLD="\033[1m"
NC="\033[0m"

ui_info() {
    local title="$1"
    local msg="$2"
    if [ "$UI_MODE" = "zenity" ]; then
        zenity --info --title="$title" --text="$msg" --width=400 2>/dev/null || true
    elif [ "$UI_MODE" = "kdialog" ]; then
        kdialog --title "$title" --msgbox "$msg" 2>/dev/null || true
    elif [ "$UI_MODE" = "yad" ]; then
        yad --info --title="$title" --text="$msg" --width=400 2>/dev/null || true
    else
        echo -e "${BLUE}${BOLD}[*] ${title}:${NC} ${msg}"
    fi
}

ui_error() {
    local title="$1"
    local msg="$2"
    if [ "$UI_MODE" = "zenity" ]; then
        zenity --error --title="$title" --text="$msg" --width=420 2>/dev/null || true
    elif [ "$UI_MODE" = "kdialog" ]; then
        kdialog --title "$title" --error "$msg" 2>/dev/null || true
    elif [ "$UI_MODE" = "yad" ]; then
        yad --error --title="$title" --text="$msg" --width=420 2>/dev/null || true
    else
        echo -e "${RED}${BOLD}[ERRORE] ${title}:${NC} ${msg}"
    fi
}

ui_ask_yesno() {
    local title="$1"
    local msg="$2"
    if [ "$IS_UPDATE" -eq 1 ]; then
        return 0
    fi
    if [ "$UI_MODE" = "zenity" ]; then
        zenity --question --title="$title" --text="$msg" --width=400 2>/dev/null
        return $?
    elif [ "$UI_MODE" = "kdialog" ]; then
        kdialog --title "$title" --yesno "$msg" 2>/dev/null
        return $?
    elif [ "$UI_MODE" = "yad" ]; then
        yad --question --title="$title" --text="$msg" --width=400 2>/dev/null
        return $?
    else
        echo -en "${YELLOW}${BOLD}[?] ${title}:${NC} ${msg} [S/n]: "
        read -r resp
        case "$resp" in
            [nN][oO]|[nN]) return 1 ;;
            *) return 0 ;;
        esac
    fi
}

# ------------------------------------------------------------------------------
# 2. CONTROLLO STRUMENTI BASE (curl, tar, cmake, compiler)
detect_distro_family() {
    if [ -f /run/ostree-booted ] || [ -f /etc/NIXOS ] || [ -d /nix/store ] || grep -qiE 'silverblue|kinoite|microos|steamos|nixos' /etc/os-release 2>/dev/null; then
        echo "immutable"
        return
    fi
    if [ -f /etc/gentoo-release ] || grep -qi "gentoo" /etc/os-release 2>/dev/null; then
        echo "gentoo"
        return
    fi
    if command -v apt-get >/dev/null 2>&1; then echo "apt"
    elif command -v dnf >/dev/null 2>&1; then echo "dnf"
    elif command -v pacman >/dev/null 2>&1; then echo "pacman"
    elif command -v zypper >/dev/null 2>&1; then echo "zypper"
    elif command -v xbps-install >/dev/null 2>&1; then echo "void"
    elif command -v eopkg >/dev/null 2>&1; then echo "solus"
    elif command -v apk >/dev/null 2>&1; then echo "alpine"
    else echo "unknown"
    fi
}

detect_package_manager() {
    detect_distro_family
}

install_missing_packages() {
    local pkgs=("$@")
    local PM
    PM=$(detect_package_manager)
    
    if [ "$PM" = "immutable" ]; then
        ui_info "Sistema Immutabile Rilevato" "Il tuo sistema ha il file system di sistema in sola lettura (OSTree / NixOS / SteamOS).\n\nNon è consigliato installare pacchetti in /usr.\nConsigliato: procedi compilando con motori incorporati da sorgente."
        return 0
    fi
    if [ "$PM" = "gentoo" ]; then
        ui_info "Gentoo Linux Rilevato" "Installa i pacchetti tramite portage:\nsudo emerge --ask ${pkgs[*]}"
        return 0
    fi

    local install_cmd=""
    case "$PM" in
        apt)
            install_cmd="apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y ${pkgs[*]}"
            ;;
        dnf)
            install_cmd="dnf install -y ${pkgs[*]}"
            ;;
        pacman)
            install_cmd="pacman -Sy --noconfirm --needed ${pkgs[*]}"
            ;;
        zypper)
            install_cmd="zypper --non-interactive in ${pkgs[*]}"
            ;;
        void)
            install_cmd="xbps-install -y ${pkgs[*]}"
            ;;
        solus)
            install_cmd="eopkg install -y ${pkgs[*]}"
            ;;
        alpine)
            install_cmd="apk add ${pkgs[*]}"
            ;;
        *)
            ui_error "Installatore Pacchetti" "Gestore pacchetti non supportato. Installa manualmente: ${pkgs[*]}"
            return 1
            ;;
    esac

    if [ "$EUID" -eq 0 ]; then
        bash -c "$install_cmd"
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec bash -c "$install_cmd"
    elif command -v sudo >/dev/null 2>&1; then
        sudo bash -c "$install_cmd"
    else
        ui_error "Permessi insufficienti" "Sono necessari i privilegi di root per installare: ${pkgs[*]}"
        return 1
    fi
}

check_build_tools() {
    local missing_tools=()
    local missing_libs=()
    local PM
    PM=$(detect_package_manager)

    command -v curl >/dev/null 2>&1 || missing_tools+=("curl")
    command -v tar >/dev/null 2>&1 || missing_tools+=("tar")
    command -v cmake >/dev/null 2>&1 || missing_tools+=("cmake")
    command -v g++ >/dev/null 2>&1 || command -v clang++ >/dev/null 2>&1 || {
        case "$PM" in
            apt) missing_tools+=("build-essential" "g++") ;;
            pacman) missing_tools+=("base-devel" "gcc") ;;
            dnf) missing_tools+=("gcc-c++" "make") ;;
            *) missing_tools+=("g++") ;;
        esac
    }
    command -v pkg-config >/dev/null 2>&1 || {
        case "$PM" in
            apt) missing_tools+=("pkg-config") ;;
            pacman) missing_tools+=("pkgconf") ;;
            *) missing_tools+=("pkg-config") ;;
        esac
    }

    # Verifica presenza librerie di sviluppo C++ / Qt6 via pkg-config
    check_pkg_dev() {
        local pkg_name="$1"
        pkg-config --exists "$pkg_name" 2>/dev/null
    }

    # Se pkg-config è già installato, verifichiamo in dettaglio le librerie
    if command -v pkg-config >/dev/null 2>&1; then
        case "$PM" in
            apt)
                check_pkg_dev "Qt6Core" || missing_libs+=("qt6-base-dev" "qt6-base-dev-tools")
                check_pkg_dev "Qt6Multimedia" || missing_libs+=("qt6-multimedia-dev")
                check_pkg_dev "poppler-qt6" || missing_libs+=("libpoppler-qt6-dev")
                check_pkg_dev "libarchive" || missing_libs+=("libarchive-dev")
                check_pkg_dev "librevenge-0.0" || missing_libs+=("librevenge-dev")
                check_pkg_dev "libqrencode" || missing_libs+=("libqrencode-dev")
                check_pkg_dev "mpv" || missing_libs+=("libmpv-dev")
                ;;
            pacman)
                check_pkg_dev "Qt6Core" || missing_libs+=("qt6-base")
                check_pkg_dev "Qt6Multimedia" || missing_libs+=("qt6-multimedia")
                check_pkg_dev "poppler-qt6" || missing_libs+=("poppler-qt6")
                check_pkg_dev "libarchive" || missing_libs+=("libarchive")
                check_pkg_dev "librevenge-0.0" || missing_libs+=("librevenge")
                check_pkg_dev "libqrencode" || missing_libs+=("qrencode")
                check_pkg_dev "mpv" || missing_libs+=("mpv")
                ;;
            dnf)
                check_pkg_dev "Qt6Core" || missing_libs+=("qt6-qtbase-devel")
                check_pkg_dev "Qt6Multimedia" || missing_libs+=("qt6-qtmultimedia-devel")
                check_pkg_dev "poppler-qt6" || missing_libs+=("poppler-qt6-devel")
                check_pkg_dev "libarchive" || missing_libs+=("libarchive-devel")
                check_pkg_dev "librevenge-0.0" || missing_libs+=("librevenge-devel")
                check_pkg_dev "libqrencode" || missing_libs+=("qrencode-devel")
                check_pkg_dev "mpv" || missing_libs+=("mpv-libs-devel")
                ;;
        esac
    else
        # Se pkg-config non c'è ancora, accoda direttamente le dipendenze per Debian/Ubuntu
        if [ "$PM" = "apt" ]; then
            missing_libs+=("qt6-base-dev" "qt6-base-dev-tools" "qt6-multimedia-dev" "libpoppler-qt6-dev" "libarchive-dev" "librevenge-dev" "libqrencode-dev" "libmpv-dev")
        elif [ "$PM" = "pacman" ]; then
            missing_libs+=("qt6-base" "qt6-multimedia" "poppler-qt6" "libarchive" "librevenge" "qrencode" "mpv")
        elif [ "$PM" = "dnf" ]; then
            missing_libs+=("qt6-qtbase-devel" "qt6-qtmultimedia-devel" "poppler-qt6-devel" "libarchive-devel" "librevenge-devel" "qrencode-devel" "mpv-libs-devel")
        fi
    fi

    local all_missing=("${missing_tools[@]}" "${missing_libs[@]}")
    if [ ${#all_missing[@]} -gt 0 ]; then
        ui_info "Installazione Dipendenze" "Per compilare l'applicazione è necessario installare i seguenti pacchetti:
${all_missing[*]}

Procedo con l'installazione automatica..."
        install_missing_packages "${all_missing[@]}" || {
            ui_error "Errore" "Impossibile installare i pacchetti richiesti. Installa manualmente: ${all_missing[*]}"
            exit 1
        }
    fi
}

# ------------------------------------------------------------------------------
# 3. DOWNLOAD SORGENTI (GITHUB RELEASES O GOOGLE DRIVE)
# ------------------------------------------------------------------------------
download_from_drive() {
    download_source_payload "$@"
}

download_source_payload() {
    local source_url="$1"
    local dest_file="$2"

    if [[ "$source_url" =~ drive\.google\.com ]]; then
        local file_id=""
        if [[ "$source_url" =~ /d/([^/]+) ]]; then
            file_id="${BASH_REMATCH[1]}"
        elif [[ "$source_url" =~ id=([^&]+) ]]; then
            file_id="${BASH_REMATCH[1]}"
        fi

        if [ -z "$file_id" ]; then
            ui_error "Download" "Link di Google Drive non valido o non trovato."
            exit 1
        fi

        local cookie_file
        cookie_file=$(mktemp)
        
        local confirm_token
        confirm_token=$(curl -s -c "$cookie_file" -L "https://drive.google.com/uc?export=download&id=${file_id}" | \
            grep -o 'name="confirm" value="[^"]*"' | head -n 1 | sed -e 's/name="confirm" value="//' -e 's/"//' || true)

        if [ -z "$confirm_token" ]; then
            confirm_token=$(curl -s -c "$cookie_file" -L "https://drive.google.com/uc?export=download&id=${file_id}" | \
                grep -o 'confirm=[0-9a-zA-Z_]\+' | head -n 1 | cut -d'=' -f2 || true)
        fi

        local download_url="https://drive.google.com/uc?export=download&id=${file_id}"
        if [ -n "$confirm_token" ]; then
            download_url="https://drive.google.com/uc?export=download&confirm=${confirm_token}&id=${file_id}"
        fi

        if [ "$UI_MODE" = "zenity" ]; then
            (
                curl -b "$cookie_file" -L "$download_url" -o "$dest_file" 2>&1 | \
                stdbuf -oL tr '\r' '\n' | \
                grep --line-buffered -o '[0-9]*\.[0-9]*%' | \
                sed -u 's/\..*//'
            ) | zenity --progress --title="Scaricamento $APP_NAME" --text="Download dei sorgenti da Google Drive..." --percentage=0 --auto-close 2>/dev/null || true
        else
            echo -e "${BLUE}[*] Scaricamento dei sorgenti da Google Drive...${NC}"
            curl -b "$cookie_file" -L --progress-bar "$download_url" -o "$dest_file"
        fi

        rm -f "$cookie_file"
    else
        # Download diretto ad alta velocità (GitHub Releases o CDN diretta)
        if [ "$UI_MODE" = "zenity" ]; then
            (
                curl -L "$source_url" -o "$dest_file" 2>&1 | \
                stdbuf -oL tr '\r' '\n' | \
                grep --line-buffered -o '[0-9]*\.[0-9]*%' | \
                sed -u 's/\..*//'
            ) | zenity --progress --title="Scaricamento $APP_NAME" --text="Download dei sorgenti da GitHub..." --percentage=0 --auto-close 2>/dev/null || true
        else
            echo -e "${BLUE}[*] Scaricamento dei sorgenti da GitHub...${NC}"
            curl -L --progress-bar "$source_url" -o "$dest_file"
        fi
    fi

    if [ ! -s "$dest_file" ]; then
        ui_error "Download fallito" "Il download non ha prodotto un file valido."
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# 4. COMPILAZIONE COMPONENTI DA SORGENTE (Fallback & Custom Recipes)
# ------------------------------------------------------------------------------
build_source_component() {
    local comp="$1"
    local custom_url="$2"
    local custom_tag="$3"
    local custom_flags="$4"
    local repo_url=""
    local repo_tag="main"
    local cmake_flags=()

    case "$comp" in
        tesseract|ocr|tesseract-ocr)
            repo_url="https://github.com/tesseract-ocr/tesseract.git"
            repo_tag="5.4.1"
            cmake_flags+=("-DBUILD_TRAINEDDATA=OFF" "-DBUILD_TRAINING_TOOLS=OFF" "-DBUILD_TESTS=OFF" "-DCMAKE_CXX_FLAGS_RELEASE=-O3 -march=native -funroll-loops -falign-loops=32 -flto=auto -fomit-frame-pointer -pipe")
            ;;
        qpdf)
            repo_url="https://github.com/qpdf/qpdf.git"
            repo_tag="v11.9.1"
            cmake_flags+=("-DBUILD_STATIC_LIBS=OFF" "-DBUILD_DOC=OFF" "-DREQUIRE_CRYPTO_OPENSSL=ON" "-DCMAKE_CXX_FLAGS_RELEASE=-O3 -march=native -funroll-loops -falign-loops=32 -flto=auto -fomit-frame-pointer -pipe")
            ;;
        libarchive|archive|engine-libarchive)
            repo_url="https://github.com/libarchive/libarchive.git"
            repo_tag="v3.7.4"
            cmake_flags+=("-DENABLE_TEST=OFF" "-DENABLE_TAR=OFF" "-DENABLE_CPIO=OFF" "-DENABLE_CAT=OFF" "-DENABLE_UNZIP=OFF" "-DCMAKE_C_FLAGS_RELEASE=-O3 -march=native -mcrc32 -fno-strict-aliasing -funroll-loops -falign-loops=32 -flto=auto -fomit-frame-pointer -fno-semantic-interposition -pipe")
            ;;
        poppler|engine-poppler)
            repo_url="https://gitlab.freedesktop.org/poppler/poppler.git"
            repo_tag="poppler-26.08.0"
            cmake_flags+=("-DENABLE_QT6=ON" "-DENABLE_QT5=OFF" "-DENABLE_GLIB=OFF" "-DENABLE_CPP=OFF" "-DENABLE_BOOST=OFF" "-DENABLE_UTILS=ON" "-DENABLE_NSS3=OFF" "-DENABLE_GPGME=OFF" "-DENABLE_LIBCURL=OFF" "-DBUILD_QT6_TESTS=OFF" "-DBUILD_CPP_TESTS=OFF" "-DBUILD_MANUAL_TESTS=OFF" "-DCMAKE_CXX_FLAGS_RELEASE=-O3 -march=native -mcrc32 -funroll-loops -falign-loops=32 -flto=auto -fomit-frame-pointer -fno-semantic-interposition -pipe")
            ;;
        7zip|7z|7zz)
            repo_url="https://github.com/ip7z/7zip.git"
            repo_tag="24.08"
            ;;
        image-formats|qtimageformats|qt6-imageformats|qt6-image-formats-plugins)
            comp="qtimageformats"
            repo_url="https://github.com/qt/qtimageformats.git"
            local qt_sys_ver
            qt_sys_ver=$(pkg-config --modversion Qt6Core 2>/dev/null || qmake6 -query QT_VERSION 2>/dev/null || echo "")
            if [ -n "$qt_sys_ver" ]; then
                repo_tag="v${qt_sys_ver}"
            else
                repo_tag="v6.8.0"
            fi
            cmake_flags+=("-DCMAKE_CXX_FLAGS_RELEASE=-O3 -march=native -funroll-loops -falign-loops=32 -flto=auto -fomit-frame-pointer -pipe")
            ;;
        *)
            echo -e "${RED}${BOLD}[!] Errore: Il componente '${comp}' non ha una ricetta di compilazione sorgente.${NC}"
            echo -e "${RED}    Componenti supportati: poppler, engine-poppler, libarchive, engine-libarchive, 7zip, qpdf, tesseract, image-formats.${NC}"
            exit 1
            ;;
    esac

    # Applica override personalizzati se specificati
    if [ -n "$custom_url" ]; then
        repo_url="$custom_url"
    fi
    if [ -n "$custom_tag" ]; then
        repo_tag="$custom_tag"
    fi
    if [ -n "$custom_flags" ]; then
        eval "extra_flags_array=($custom_flags)"
        cmake_flags+=("${extra_flags_array[@]}")
    fi

    echo -e "${BLUE}${BOLD}[*] Compilazione ${comp} (${repo_tag}) da sorgente per l'ambiente utente (${HOME}/.local)...${NC}"
    echo -e "${BLUE}    Sorgente: ${repo_url}${NC}"
    if [ -n "$custom_flags" ]; then
        echo -e "${BLUE}    Flag extra: ${custom_flags}${NC}"
    fi

    local COMP_SRC="${SCRIPT_DIR}/build_deps/${comp}"
    local COMP_BUILD="${SCRIPT_DIR}/build_deps/${comp}_build"
    mkdir -p "${SCRIPT_DIR}/build_deps"
    if [ ! -d "$COMP_SRC/.git" ]; then
        if ! git clone --depth 1 -b "$repo_tag" "$repo_url" "$COMP_SRC" 2>/dev/null; then
            echo -e "${YELLOW}[!] Tag '${repo_tag}' non trovato, fallback su ramo principale...${NC}"
            git clone --depth 1 -b "6.8" "$repo_url" "$COMP_SRC" 2>/dev/null || git clone --depth 1 "$repo_url" "$COMP_SRC"
        fi
    else
        (cd "$COMP_SRC" && git fetch --depth 1 origin "$repo_tag" 2>/dev/null || true && git checkout "$repo_tag" 2>/dev/null || true)
    fi
    local cpu_cores_sub
    cpu_cores_sub=$(nproc 2>/dev/null || echo "4")

    if [ "$comp" = "7zip" ] || [ "$comp" = "7z" ] || [ "$comp" = "7zz" ]; then
        local flags_7z="-O3 -march=native -mcrc32 -funroll-loops -falign-loops=32 -flto -fomit-frame-pointer -pipe"
        if [ -n "$custom_flags" ]; then
            flags_7z="$custom_flags"
        fi
        echo -e "${BLUE}${BOLD}[*] Compilazione 7-Zip (7zz) con makefile.gcc (${cpu_cores_sub} thread)...${NC}"
        (cd "${COMP_SRC}/CPP/7zip/Bundles/Alone2" && make -j"${cpu_cores_sub}" -f makefile.gcc LOCAL_FLAGS="${flags_7z}")
        mkdir -p "${HOME}/.local/bin"
        install -m 755 "${COMP_SRC}/CPP/7zip/Bundles/Alone2/_o/7zz" "${HOME}/.local/bin/7zz"
        echo -e "${GREEN}${BOLD}[✓] Componente '7zz' installato con successo in ${HOME}/.local/bin/7zz!${NC}"
        exit 0
    fi

    mkdir -p "$COMP_BUILD"
    if ! cmake -B "$COMP_BUILD" -S "$COMP_SRC" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="${HOME}/.local" -DCMAKE_INSTALL_RPATH='$ORIGIN/../lib:$ORIGIN/../lib64' -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=TRUE -DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE "${cmake_flags[@]}"; then
        echo -e "${YELLOW}[!] Configurazione CMake fallita; pulizia cache e nuovo tentativo...${NC}"
        rm -rf "${COMP_BUILD}"
        mkdir -p "${COMP_BUILD}"
        cmake -B "$COMP_BUILD" -S "$COMP_SRC" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="${HOME}/.local" -DCMAKE_INSTALL_RPATH='$ORIGIN/../lib:$ORIGIN/../lib64' -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=TRUE -DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE "${cmake_flags[@]}"
    fi
    cmake --build "$COMP_BUILD" --parallel "$cpu_cores_sub"
    cmake --install "$COMP_BUILD"
    echo -e "${GREEN}${BOLD}[✓] Componente '${comp}' installato con successo in ${HOME}/.local!${NC}"
    exit 0
}

# ------------------------------------------------------------------------------
# 5. CONFIGURAZIONE OTTIMIZZAZIONE E BUILD
# ------------------------------------------------------------------------------
select_cpu_optimization() {
    CMAKE_OPT_FLAGS=(-DCMAKE_BUILD_TYPE=Release)
}

# ------------------------------------------------------------------------------
# 6. CONFIGURAZIONE MODULI
# ------------------------------------------------------------------------------
configure_cmake_modules() {
    CMAKE_EXTRA_MODULES_FLAGS=()
}

# ------------------------------------------------------------------------------
# 7. FUNZIONALITÀ DI GESTIONE (Clean, Reinstall, Doctor, Reset, Uninstall, Menu)
# ------------------------------------------------------------------------------
do_clean() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo -e "${BLUE}${BOLD}[*] Pulizia file temporanei di compilazione in corso...${NC}"

    local dirs_to_clean=(
        "${script_dir}/build_install"
        "${script_dir}/build_deb"
        "${script_dir}/build_fedora"
        "${script_dir}/build"
    )

    local bytes_freed=0
    for d in "${dirs_to_clean[@]}"; do
        if [ -d "$d" ]; then
            local sz
            sz=$(du -sb "$d" 2>/dev/null | awk '{print $1}' || echo "0")
            bytes_freed=$((bytes_freed + sz))
            echo -e "${BLUE}    Rimozione: ${d}${NC}"
            rm -rf "$d"
        fi
    done

    # Pulisci anche le cartelle di build intermedie di build_deps (senza toccare i sorgenti git)
    find "${script_dir}/build_deps" -maxdepth 1 -type d -name "*_build" -exec rm -rf {} + 2>/dev/null || true
    find "${script_dir}" -maxdepth 1 -type f -name "*.log" -exec rm -f {} + 2>/dev/null || true

    local mb_freed=$((bytes_freed / 1024 / 1024))
    echo -e "${GREEN}${BOLD}[✓] Pulizia completata! Liberati circa ${mb_freed} MB di cache di build.${NC}"
    if [ "$UI_MODE" != "cli" ] && [ "$FORCE_CLI" -eq 0 ]; then
        ui_info "Pulizia Completata" "Tutte le cartelle di build temporanee sono state rimosse.\nSpazio liberato: ~${mb_freed} MB."
    fi
}

do_reinstall() {
    echo -e "${BLUE}${BOLD}[*] Avvio procedura di reinstallazione pulita da zero...${NC}"
    do_clean
    echo -e "${BLUE}${BOLD}[*] Ricompilazione e installazione pulita...${NC}"
    IS_UPDATE=1
    ACTION=""
}

do_reset_config() {
    local cfg_dir="$HOME/.config/Bubez"
    local cfg_file="$cfg_dir/BubezView.conf"

    if [ "$FORCE_CLI" -eq 0 ] && [ "$UI_MODE" != "cli" ]; then
        if ! ui_ask_yesno "Reset Configurazione" "Vuoi ripristinare le impostazioni predefinite di BubezView?\n\nVerrà creato un backup automatico prima del ripristino."; then
            echo -e "${YELLOW}[*] Operazione annullata dall'utente.${NC}"
            exit 0
        fi
    fi

    echo -e "${BLUE}${BOLD}[*] Reset configurazione in corso...${NC}"
    if [ -f "$cfg_file" ]; then
        local ts
        ts=$(date +%Y%m%d_%H%M%S)
        cp -f "$cfg_file" "${cfg_file}.bak_${ts}"
        rm -f "$cfg_file"
        echo -e "${GREEN}${BOLD}[✓] File di configurazione ripristinato! Backup salvato in: ${cfg_file}.bak_${ts}${NC}"
    else
        echo -e "${YELLOW}[*] Nessun file di configurazione preesistente trovato in $cfg_file.${NC}"
    fi

    rm -rf "$HOME/.cache/BubezView"

    if [ "$UI_MODE" != "cli" ] && [ "$FORCE_CLI" -eq 0 ]; then
        ui_info "Reset Configurazione" "Impostazioni ripristinate ai valori di fabbrica con successo!\n(Creato backup di sicurezza in ~/.config/Bubez/)"
    fi
    exit 0
}

do_doctor() {
    echo -e "${BLUE}${BOLD}==============================================================================${NC}"
    echo -e "${BLUE}${BOLD}               🩺 BUBEZVIEW SYSTEM & ENVIRONMENT DOCTOR                        ${NC}"
    echo -e "${BLUE}${BOLD}==============================================================================${NC}"

    local report=""
    add_rep() {
        echo -e "$1"
        report+="${2:-$1}\n"
    }

    # 1. Stato installazione
    local bin_path="$HOME/.local/bin/$APP_ID"
    local real_bin="$HOME/.local/share/$APP_ID/$TARGET_EXE"
    if [ -f "$real_bin" ]; then
        local ver
        ver=$("$real_bin" --version 2>/dev/null || echo "presente")
        local bdate
        bdate=$(date -r "$real_bin" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "")
        add_rep "${GREEN}[✓] BubezView installato nel sistema:${NC} $bin_path ($ver - $bdate)" "✓ BubezView installato: $ver ($bdate)"
    else
        add_rep "${YELLOW}[!] BubezView NON è installato nel sistema host (~/.local/bin/bubezview non trovato).${NC}" "! BubezView NON installato nel sistema"
    fi

    # 2. Integrazione desktop e icone
    local dtop="$HOME/.local/share/applications/$APP_ID.desktop"
    if [ -f "$dtop" ]; then
        add_rep "${GREEN}[✓] Lanciatore Desktop:${NC} Presente ($dtop)" "✓ Lanciatore Desktop: Presente"
    else
        add_rep "${YELLOW}[!] Lanciatore Desktop:${NC} Assente" "! Lanciatore Desktop: Assente"
    fi

    local dolphin_kio="$HOME/.local/share/kio/servicemenus/$APP_ID.desktop"
    if [ -f "$dolphin_kio" ]; then
        add_rep "${GREEN}[✓] Integrazione Dolphin (Tasto Spazio / Menu):${NC} Attiva ($dolphin_kio)" "✓ Integrazione Dolphin: Attiva"
    else
        add_rep "${YELLOW}[!] Integrazione Dolphin:${NC} Non configurata" "! Integrazione Dolphin: Non configurata"
    fi

    # 3. Motori e dipendenze esterne
    echo ""
    add_rep "${BOLD}[*] Controllo Motori e Formati Multimediali:${NC}" "\nMotori e Formati Multimediali:"

    check_dep() {
        local name="$1"
        local cmd="$2"
        local desc="$3"
        if command -v "$cmd" >/dev/null 2>&1; then
            local p
            p=$(command -v "$cmd")
            add_rep "  ${GREEN}[✓] ${name}:${NC} Presente ($p) — $desc" "  ✓ ${name}: Presente ($desc)"
        else
            add_rep "  ${YELLOW}[-] ${name}:${NC} Non trovato nel PATH di sistema — $desc" "  - ${name}: Non trovato ($desc)"
        fi
    }

    check_dep "Poppler (pdftoppm)" "pdftoppm" "Rendering PDF e documenti"
    if command -v "7zz" >/dev/null 2>&1; then
        check_dep "7-Zip (7zz)" "7zz" "Supporto esteso archivi (RAR, 7Z, ISO)"
    else
        check_dep "7-Zip (7z)" "7z" "Supporto archivi"
    fi
    check_dep "QPDF" "qpdf" "Riparazione, linearizzazione e crittografia PDF"
    check_dep "Tesseract OCR" "tesseract" "Riconoscimento ottico del testo in immagini e PDF"
    check_dep "FFmpeg" "ffmpeg" "Generazione miniature e analisi multimediale"
    check_dep "LibreOffice" "libreoffice" "Anteprima documenti Office (.docx, .xlsx, .odt)"

    # 4. Display Server e GPU
    echo ""
    add_rep "${BOLD}[*] Ambiente Grafico e Accelerazione:${NC}" "\nAmbiente Grafico e GPU:"
    if [ -n "$WAYLAND_DISPLAY" ]; then
        add_rep "  ${GREEN}[✓] Server Display:${NC} Wayland ($WAYLAND_DISPLAY)" "  ✓ Display: Wayland ($WAYLAND_DISPLAY)"
    elif [ -n "$DISPLAY" ]; then
        add_rep "  ${GREEN}[✓] Server Display:${NC} X11 ($DISPLAY)" "  ✓ Display: X11 ($DISPLAY)"
    else
        add_rep "  ${YELLOW}[!] Server Display:${NC} Nessun server grafico attivo rilevato" "  ! Nessun server grafico attivo"
    fi

    if command -v glxinfo >/dev/null 2>&1; then
        local renderer
        renderer=$(glxinfo -B 2>/dev/null | grep -i "Device:" | sed 's/.*Device: //' || true)
        if [ -n "$renderer" ]; then
            add_rep "  ${GREEN}[✓] GPU / Driver:${NC} $renderer" "  ✓ GPU: $renderer"
        fi
    fi

    echo -e "${BLUE}${BOLD}==============================================================================${NC}"
    if [ "$UI_MODE" != "cli" ] && [ "$FORCE_CLI" -eq 0 ]; then
        ui_info "Diagnostica di Sistema - BubezView Doctor" "$report"
    fi
    exit 0
}

do_uninstall() {
    if [ "$FORCE_CLI" -eq 0 ] && [ "$UI_MODE" != "cli" ]; then
        if ! ui_ask_yesno "Disinstallazione BubezView" "Sei sicuro di voler disinstallare BubezView dal tuo sistema?"; then
            echo -e "${YELLOW}[*] Disinstallazione annullata dall'utente.${NC}"
            exit 0
        fi
        if [ "$PURGE" -eq 0 ]; then
            if ui_ask_yesno "Elimina configurazione" "Vuoi rimuovere anche i file di configurazione e la cache (~/.config/Bubez e ~/.cache/BubezView)?"; then
                PURGE=1
            fi
        fi
    fi

    echo -e "${BLUE}${BOLD}[*] Disinstallazione di $APP_NAME in corso...${NC}"

    # 1. Rimuovi binario e cartella share
    rm -f "$HOME/.local/bin/$APP_ID"
    rm -rf "$HOME/.local/share/$APP_ID"

    # 2. Rimuovi lanciatore .desktop
    rm -f "$HOME/.local/share/applications/$APP_ID.desktop"

    # 3. Rimuovi icone
    rm -f "$HOME/.local/share/icons/hicolor/scalable/apps/$APP_ID".*
    rm -f "$HOME/.local/share/icons/hicolor/256x256/apps/$APP_ID".*

    # 4. Rimuovi integrazioni file manager (Dolphin ServiceMenu)
    rm -f "$HOME/.local/share/kio/servicemenus/$APP_ID.desktop"
    rm -f "$HOME/.local/share/kio/servicemenus/${APP_ID}_sviluppo.desktop"

    # 5. Se PURGE=1, rimuovi anche configurazione e cache
    if [ "$PURGE" -eq 1 ]; then
        echo -e "${YELLOW}[*] Rimozione file di configurazione e cache...${NC}"
        rm -rf "$HOME/.config/Bubez"
        rm -rf "$HOME/.config/bubezview-dev"
        rm -rf "$HOME/.cache/BubezView"
    fi

    # 6. Aggiorna database di sistema
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
    command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental 2>/dev/null || true
    command -v kbuildsycoca5 >/dev/null 2>&1 && kbuildsycoca5 --noincremental 2>/dev/null || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

    echo -e "${GREEN}${BOLD}[✓] $APP_NAME è stato disinstallato con successo dal sistema.${NC}"
    if [ "$UI_MODE" != "cli" ] && [ "$FORCE_CLI" -eq 0 ]; then
        ui_info "Disinstallazione Completata" "$APP_NAME è stato disinstallato con successo dal tuo sistema."
    fi
    exit 0
}

show_interactive_menu() {
    local choice=""
    if [ "$UI_MODE" = "zenity" ]; then
        choice=$(zenity --list --title="BubezView - Gestione Installazione" \
            --text="Scegli l'operazione da eseguire per BubezView:" \
            --radiolist --column="" --column="Codice" --column="Operazione" \
            --hide-column=2 --width=540 --height=320 \
            TRUE "install" "🚀  Installa o aggiorna BubezView" \
            FALSE "reinstall" "🔄  Reinstalla da zero (Clean Reinstall)" \
            FALSE "clean" "🧹  Pulisci file temporanei di compilazione" \
            FALSE "doctor" "🩺  Diagnostica stato e dipendenze (Doctor)" \
            FALSE "reset" "⚙️   Ripristina impostazioni predefinite" \
            FALSE "uninstall" "🗑️   Disinstalla BubezView dal sistema" \
            2>/dev/null || true)
    elif [ "$UI_MODE" = "kdialog" ]; then
        choice=$(kdialog --title "BubezView - Gestione Installazione" \
            --radiolist "Scegli l'operazione da eseguire per BubezView:" \
            "install" "🚀 Installa o aggiorna BubezView" on \
            "reinstall" "🔄 Reinstalla da zero (Clean Reinstall)" off \
            "clean" "🧹 Pulisci file temporanei di compilazione" off \
            "doctor" "🩺 Diagnostica stato e dipendenze (Doctor)" off \
            "reset" "⚙️ Ripristina impostazioni predefinite" off \
            "uninstall" "🗑️ Disinstalla BubezView dal sistema" off \
            2>/dev/null || true)
    elif [ "$UI_MODE" = "yad" ]; then
        choice=$(yad --list --title="BubezView - Gestione Installazione" \
            --text="Scegli l'operazione da eseguire:" \
            --radiolist --column="" --column="Codice" --column="Operazione" \
            --hide-column=2 --width=540 --height=320 \
            TRUE "install" "🚀 Installa o aggiorna BubezView" \
            FALSE "reinstall" "🔄 Reinstalla da zero (Clean Reinstall)" \
            FALSE "clean" "🧹 Pulisci file temporanei di compilazione" \
            FALSE "doctor" "🩺 Diagnostica stato e dipendenze (Doctor)" \
            FALSE "reset" "⚙️ Ripristina impostazioni predefinite" \
            FALSE "uninstall" "🗑️ Disinstalla BubezView dal sistema" \
            2>/dev/null || true)
    fi

    case "$choice" in
        install)
            # Procedi con l'installazione normale
            ;;
        reinstall)
            do_reinstall "$@"
            ;;
        clean)
            do_clean
            exit 0
            ;;
        doctor)
            do_doctor
            exit 0
            ;;
        reset)
            do_reset_config
            exit 0
            ;;
        uninstall)
            do_uninstall "$@"
            exit 0
            ;;
        *)
            echo -e "${YELLOW}[*] Operazione annullata.${NC}"
            exit 0
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 8. ESECUZIONE PRINCIPALE
# ------------------------------------------------------------------------------
main() {
    local orig_args=("$@")

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --uninstall)
                ACTION="uninstall"
                ;;
            --purge)
                PURGE=1
                ;;
            --clean)
                ACTION="clean"
                ;;
            --reinstall)
                ACTION="reinstall"
                ;;
            --doctor|--status)
                ACTION="doctor"
                ;;
            --reset-config)
                ACTION="reset"
                ;;
            --build-component)
                shift
                TARGET_COMPONENT="$1"
                ;;
            --git-url)
                shift
                CUSTOM_GIT_URL="$1"
                ;;
            --git-branch)
                shift
                CUSTOM_GIT_BRANCH="$1"
                ;;
            --extra-build-flags)
                shift
                CUSTOM_BUILD_FLAGS="$1"
                ;;
            --build-tesseract)
                TARGET_COMPONENT="tesseract"
                ;;
            -D*)
                EXTRA_CMAKE_ARGS+=("$1")
                ;;
        esac
        shift
    done

    # 1. Gestione azioni immediate da CLI
    if [ "$ACTION" = "uninstall" ]; then
        do_uninstall "${orig_args[@]}"
        exit 0
    elif [ "$ACTION" = "clean" ]; then
        do_clean
        exit 0
    elif [ "$ACTION" = "reinstall" ]; then
        do_reinstall "${orig_args[@]}"
    elif [ "$ACTION" = "doctor" ]; then
        do_doctor
        exit 0
    elif [ "$ACTION" = "reset" ]; then
        do_reset_config
        exit 0
    fi

    # 2. Se avviato senza argomenti con display attivo, mostra il menu interattivo
    if [ "$FORCE_CLI" -eq 0 ] && [ "${#orig_args[@]}" -eq 0 ] && [ "$UI_MODE" != "cli" ]; then
        show_interactive_menu "${orig_args[@]}"
    fi

    # 3. Se è richiesta la compilazione di un singolo componente
    if [ -n "$TARGET_COMPONENT" ]; then
        check_build_tools
        build_source_component "$TARGET_COMPONENT" "$CUSTOM_GIT_URL" "$CUSTOM_GIT_BRANCH" "$CUSTOM_BUILD_FLAGS"
        exit 0
    fi

    check_build_tools

    local work_dir
    work_dir=$(mktemp -d -t "${APP_ID}_installer_XXXXXX")
    trap 'rm -rf "$work_dir"' EXIT

    local tar_file="$work_dir/source.tar.gz"
    local extract_dir="$work_dir/source"
    mkdir -p "$extract_dir"

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local src_cmakelists=""

    if [ -f "$script_dir/CMakeLists.txt" ]; then
        src_cmakelists="$script_dir/CMakeLists.txt"
        extract_dir="$script_dir"
    else
        local info_json="$work_dir/versioni.json"
        curl -s -L "$PROJECT_URL" -o "$info_json" || {
            ui_error "Errore di Rete" "Impossibile scaricare l'indice delle versioni da $PROJECT_URL"
            exit 1
        }

        local drive_url=""
        if command -v python3 >/dev/null 2>&1; then
            drive_url=$(python3 -c "
import json, sys
try:
    with open('$info_json', 'r', encoding='utf-8') as f:
        data = json.load(f)
    app = data.get('$APP_ID', {})
    url = app.get('link_download_source') or app.get('link_download') or app.get('link_download_rolling') or ''
    print(url)
except Exception:
    pass
")
        elif command -v jq >/dev/null 2>&1; then
            drive_url=$(jq -r ".\"$APP_ID\".link_download_source // .\"$APP_ID\".link_download // .\"$APP_ID\".link_download_rolling // empty" "$info_json" 2>/dev/null || true)
        fi

        # Fallback con grep se né python3 né jq sono disponibili
        if [ -z "$drive_url" ]; then
            drive_url=$(grep -A 60 "\"$APP_ID\"" "$info_json" | grep -m 1 -E '"link_download_source"|"link_download"|"link_download_rolling"' | cut -d'"' -f4 || true)
        fi

        if [ -z "$drive_url" ]; then
            ui_error "Errore" "Link di download per '$APP_ID' non trovato nel catalogo."
            exit 1
        fi

        download_from_drive "$drive_url" "$tar_file"

        # ----------------------------------------------------------------------
        # VERIFICA INTEGRITÀ SHA-256 E AUTENTICITÀ FIRMA CRITTOGRAFICA ED25519
        # ----------------------------------------------------------------------
        if [ ! -f "$tar_file" ] || [ ! -s "$tar_file" ]; then
            ui_error "Errore Download" "Il file scaricato non esiste o è vuoto (0 byte)."
            rm -f "$tar_file"
            exit 1
        fi

        local expected_sha256=""
        local signature_b64=""

        if command -v python3 >/dev/null 2>&1; then
            eval "$(python3 -c "
import json
try:
    with open('$info_json', 'r', encoding='utf-8') as f:
        data = json.load(f)
    app = data.get('$APP_ID', {})
    sha = app.get('sha256', '')
    sig = app.get('signature', '')
    print(f'expected_sha256=\"{sha}\"')
    print(f'signature_b64=\"{sig}\"')
except Exception:
    pass
")"
        elif command -v jq >/dev/null 2>&1; then
            expected_sha256=$(jq -r ".\"$APP_ID\".sha256 // empty" "$info_json" 2>/dev/null || true)
            signature_b64=$(jq -r ".\"$APP_ID\".signature // empty" "$info_json" 2>/dev/null || true)
        fi

        if [ -z "$expected_sha256" ]; then
            expected_sha256=$(grep -A 40 "\"$APP_ID\"" "$info_json" | grep -m 1 '"sha256"' | cut -d'"' -f4 || true)
        fi
        if [ -z "$signature_b64" ]; then
            signature_b64=$(grep -A 40 "\"$APP_ID\"" "$info_json" | grep -m 1 '"signature"' | cut -d'"' -f4 || true)
        fi

        local actual_sha256=""
        if command -v sha256sum >/dev/null 2>&1; then
            actual_sha256=$(sha256sum "$tar_file" | awk '{print $1}')
        elif command -v shasum >/dev/null 2>&1; then
            actual_sha256=$(shasum -a 256 "$tar_file" | awk '{print $1}')
        elif command -v openssl >/dev/null 2>&1; then
            actual_sha256=$(openssl dgst -sha256 "$tar_file" | awk '{print $NF}')
        fi

        # 1. Controllo Impronta SHA-256
        if [ -n "$expected_sha256" ]; then
            if [ -z "$actual_sha256" ] || [ "$actual_sha256" != "$expected_sha256" ]; then
                rm -f "$tar_file"
                ui_error "Errore Integrità" "L'impronta SHA-256 del file scaricato non corrisponde! Possibile manomissione o download corrotto."
                exit 1
            fi
            echo -e "${GREEN}[✓] Impronta SHA-256 verificata con successo:${NC} $actual_sha256"
        fi

        # 2. Controllo Firma Crittografica Asimmetrica Ed25519
        if [ -n "$signature_b64" ]; then
            if [ -z "$RELEASE_PUBKEY" ]; then
                rm -f "$tar_file"
                ui_error "Errore Sicurezza" "Firma crittografica presente ma Chiave Pubblica non configurata nell'installer."
                exit 1
            fi

            local pubkey_file="$work_dir/release_pubkey.pem"
            local hash_file="$work_dir/release_hash.txt"
            local sig_file="$work_dir/release_sig.bin"

            if [[ "$RELEASE_PUBKEY" == *"BEGIN PUBLIC KEY"* ]]; then
                printf "%s\n" "$RELEASE_PUBKEY" > "$pubkey_file"
            else
                local clean_key
                clean_key="$(echo "$RELEASE_PUBKEY" | tr -d '[:space:]')"
                cat << PUB_EOF > "$pubkey_file"
-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEA${clean_key}
-----END PUBLIC KEY-----
PUB_EOF
            fi

            printf "%s" "$actual_sha256" > "$hash_file"

            if ! (echo "$signature_b64" | base64 -d > "$sig_file" 2>/dev/null); then
                rm -f "$tar_file" "$sig_file" "$hash_file" "$pubkey_file"
                ui_error "Errore Sicurezza" "Firma crittografica presente ma non decodificabile (Base64 invalido)."
                exit 1
            fi

            local sig_valid=0

            # Metodo primario: OpenSSL pkeyutl con PureEdDSA raw in
            if command -v openssl >/dev/null 2>&1; then
                if openssl pkeyutl -verify -rawin -pubin -inkey "$pubkey_file" -in "$hash_file" -sigfile "$sig_file" >/dev/null 2>&1; then
                    sig_valid=1
                fi
            fi

            # Metodo fallback: Python cryptography
            if [ "$sig_valid" -eq 0 ] && command -v python3 >/dev/null 2>&1; then
                if python3 -c "
import sys
try:
    from cryptography.hazmat.primitives.asymmetric import ed25519
    from cryptography.hazmat.primitives import serialization
    with open('$pubkey_file', 'rb') as f:
        pub = serialization.load_pem_public_key(f.read())
    with open('$hash_file', 'rb') as f:
        data = f.read()
    with open('$sig_file', 'rb') as f:
        sig = f.read()
    pub.verify(sig, data)
    sys.exit(0)
except Exception:
    sys.exit(1)
" >/dev/null 2>&1; then
                    sig_valid=1
                fi
            fi

            rm -f "$sig_file" "$hash_file" "$pubkey_file"

            if [ "$sig_valid" -ne 1 ]; then
                rm -f "$tar_file"
                ui_error "Errore Sicurezza" "Verifica della firma crittografica Ed25519 FALLITA! Il pacchetto potrebbe essere stato manomesso o non proviene dallo sviluppatore ufficiale."
                exit 1
            fi

            echo -e "${GREEN}[✓] Firma crittografica Ed25519 AUTENTICATA con successo!${NC}"
        fi

        if [ "$UI_MODE" = "zenity" ]; then
            (
                tar -xzf "$tar_file" -C "$extract_dir" --strip-components=1 2>&1 || \
                tar -xzf "$tar_file" -C "$extract_dir" 2>&1
            ) | zenity --progress --title="Estrazione - $APP_NAME" --text="Estrazione dei file in corso..." --pulsate --auto-close 2>/dev/null || true
        else
            echo -e "${BLUE}[*] Estrazione archivio sorgente...${NC}"
            tar -xzf "$tar_file" -C "$extract_dir" --strip-components=1 2>/dev/null || \
            tar -xzf "$tar_file" -C "$extract_dir" 2>/dev/null
        fi

        src_cmakelists="$extract_dir/CMakeLists.txt"
        if [ ! -f "$src_cmakelists" ]; then
            src_cmakelists=$(find "$extract_dir" -maxdepth 3 -name "CMakeLists.txt" | head -n 1 || true)
            if [ -n "$src_cmakelists" ]; then
                extract_dir="$(dirname "$src_cmakelists")"
            fi
        fi
    fi

    if [ ! -f "$src_cmakelists" ]; then
        ui_error "Errore Compilazione" "Nessun file CMakeLists.txt trovato nei sorgenti dell'applicazione."
        exit 1
    fi

    select_cpu_optimization
    configure_cmake_modules "$src_cmakelists"

    local build_dir="$extract_dir/build_install"
    rm -rf "$build_dir/CMakeCache.txt" "$build_dir/CMakeFiles" 2>/dev/null || true
    mkdir -p "$build_dir"

    local make_prog=""
    if command -v make >/dev/null 2>&1; then
        make_prog=$(command -v make)
    elif command -v gmake >/dev/null 2>&1; then
        make_prog=$(command -v gmake)
    fi
    local make_flag=()
    if [ -n "$make_prog" ]; then
        make_flag=("-DCMAKE_MAKE_PROGRAM=$make_prog")
    fi

    local build_log="$work_dir/${APP_ID}_build.log"
    rm -f "$build_log" 2>/dev/null || true

    if [ "$UI_MODE" = "zenity" ]; then
        (
            echo "# Configurazione del progetto con CMake..."
            cmake -S "$extract_dir" -B "$build_dir" -DBUILD_TESTS=OFF "${make_flag[@]}" "${CMAKE_OPT_FLAGS[@]}" "${CMAKE_EXTRA_MODULES_FLAGS[@]}" "${EXTRA_CMAKE_ARGS[@]}" >> "$build_log" 2>&1
        ) | zenity --progress --title="CMake Configure - $APP_NAME" --text="Preparazione della build..." --pulsate --auto-close 2>/dev/null || true
    else
        echo -e "${BLUE}[*] Esecuzione configurazione CMake...${NC}"
        cmake -S "$extract_dir" -B "$build_dir" -DBUILD_TESTS=OFF "${make_flag[@]}" "${CMAKE_OPT_FLAGS[@]}" "${CMAKE_EXTRA_MODULES_FLAGS[@]}" "${EXTRA_CMAKE_ARGS[@]}" 2>&1 | tee -a "$build_log"
    fi

    if [ ! -f "$build_dir/CMakeCache.txt" ]; then
        local err_tail
        err_tail=$(tail -n 25 "$build_log" 2>/dev/null || true)
        ui_error "Errore Configurazione CMake" "La configurazione di CMake è fallita.\nLog: $build_log\n\n$err_tail"
        exit 1
    fi

    local cpu_cores
    cpu_cores=$(nproc 2>/dev/null || echo "2")

    local build_ret=0
    if [ "$UI_MODE" = "zenity" ]; then
        (
            echo "# Compilazione in corso con $cpu_cores thread..."
            cmake --build "$build_dir" --parallel "$cpu_cores" >> "$build_log" 2>&1
        ) | zenity --progress --title="Compilazione - $APP_NAME" --text="Compilazione del codice sorgente C++ in corso..." --pulsate --auto-close 2>/dev/null || true
    else
        echo -e "${BLUE}[*] Compilazione in corso ($cpu_cores core)...${NC}"
        cmake --build "$build_dir" --parallel "$cpu_cores" 2>&1 | tee -a "$build_log" || build_ret=$?
    fi

    local exe_path=""
    if [ -n "$TARGET_EXE" ] && [ -f "$build_dir/$TARGET_EXE" ]; then
        exe_path="$build_dir/$TARGET_EXE"
    else
        exe_path=$(find "$build_dir" -maxdepth 2 -type f -executable ! -name "*.sh" ! -name "cmake*" | head -n 1 || true)
    fi

    if [ "$build_ret" -ne 0 ] || [ -z "$exe_path" ] || [ ! -f "$exe_path" ]; then
        local err_tail
        err_tail=$(tail -n 25 "$build_log" 2>/dev/null || true)
        ui_error "Errore Compilazione" "Compilazione fallita. L'eseguibile non è stato generato.\nFile di log salvato in: $build_log\n\nUltime righe di errore:\n$err_tail"
        exit 1
    fi

    local user_bin="$HOME/.local/bin"
    local user_apps="$HOME/.local/share/applications"
    local user_icons="$HOME/.local/share/icons/hicolor/scalable/apps"
    local app_install_dir="$HOME/.local/share/$APP_ID"

    mkdir -p "$user_bin" "$user_apps" "$user_icons" "$app_install_dir"

    local final_exe_name
    final_exe_name=$(basename "$exe_path")
    cp -f "$exe_path" "$app_install_dir/$final_exe_name"
    chmod +x "$app_install_dir/$final_exe_name"
    ln -sf "$app_install_dir/$final_exe_name" "$user_bin/$APP_ID"

    # Installazione formale tramite CMake e sincronizzazione dei plugin modulari (.so)
    cmake --install "$build_dir" --prefix "$HOME/.local" >> "$build_log" 2>&1 || true

    local plugins_dir="$HOME/.local/lib/$APP_ID/plugins"
    local plugins_share_dir="$HOME/.local/share/$APP_ID/plugins"
    mkdir -p "$plugins_dir" "$plugins_share_dir" "$app_install_dir/plugins"
    if [ -d "$build_dir/plugins" ]; then
        find "$build_dir/plugins" -type f -name "*.so" -exec cp -f {} "$plugins_dir/" \; 2>/dev/null || true
        find "$build_dir/plugins" -type f -name "*.so" -exec cp -f {} "$plugins_share_dir/" \; 2>/dev/null || true
        find "$build_dir/plugins" -type f -name "*.so" -exec cp -f {} "$app_install_dir/plugins/" \; 2>/dev/null || true
    fi

    # Salva una copia dell'installer autonomo per futuri aggiornamenti
    if [ -f "$0" ]; then
        cp -f "$0" "$app_install_dir/Install" 2>/dev/null || true
        chmod +x "$app_install_dir/Install" 2>/dev/null || true
        ln -sf "Install" "$app_install_dir/install.sh" 2>/dev/null || true
    fi

    local found_icon=""
    if [ -n "$ICON_NAME" ] && [ -f "$extract_dir/$ICON_NAME" ]; then
        found_icon="$extract_dir/$ICON_NAME"
    else
        found_icon=$(find "$extract_dir" -maxdepth 3 \( -name "*.png" -o -name "*.svg" -o -name "*.jpg" \) | head -n 1 || true)
    fi

    local icon_ext="png"
    if [ -n "$found_icon" ]; then
        icon_ext="${found_icon##*.}"
        cp -f "$found_icon" "$app_install_dir/icon.$icon_ext"
        mkdir -p "$HOME/.local/share/icons/hicolor/scalable/apps" "$HOME/.local/share/icons/hicolor/256x256/apps"
        cp -f "$found_icon" "$HOME/.local/share/icons/hicolor/scalable/apps/$APP_ID.$icon_ext" 2>/dev/null || true
        cp -f "$found_icon" "$HOME/.local/share/icons/hicolor/256x256/apps/$APP_ID.$icon_ext" 2>/dev/null || true
        command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
    fi

    cat <<DESKTOP_EOF > "$user_apps/$APP_ID.desktop"
[Desktop Entry]
Type=Application
Name=$APP_NAME
Exec=$user_bin/$APP_ID %F
Icon=$APP_ID
Terminal=false
StartupWMClass=$APP_ID
Categories=${APP_CATEGORY:-Utility};
DESKTOP_EOF
    chmod +x "$user_apps/$APP_ID.desktop"

    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$user_apps" 2>/dev/null || true
    command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental 2>/dev/null || true
    command -v kbuildsycoca5 >/dev/null 2>&1 && kbuildsycoca5 --noincremental 2>/dev/null || true

    # --------------------------------------------------------------------------
    # 7. TEST DI VERIFICA FINALE (Librerie dinamiche & Smoke Test)
    # --------------------------------------------------------------------------
    local installed_bin="$app_install_dir/$final_exe_name"
    local test_failed=0
    local test_err_msg=""

    # A. Verifica se ci sono librerie dinamiche non risolte con ldd
    if command -v ldd >/dev/null 2>&1; then
        local missing_so
        missing_so=$(ldd "$installed_bin" 2>/dev/null | grep -i "not found" || true)
        if [ -n "$missing_so" ]; then
            test_failed=1
            test_err_msg="Librerie dinamiche mancanti riscontrate nel binario:\n$missing_so"
        fi
    fi

    # B. Smoke test: Prova a verificare l'eseguibilità del binario
    if [ "$test_failed" -eq 0 ]; then
        if ! timeout 2s "$installed_bin" --version >/dev/null 2>&1 && \
           ! timeout 2s "$installed_bin" --help >/dev/null 2>&1 && \
           ! timeout 2s "$installed_bin" -h >/dev/null 2>&1; then
            # Se il programma non ha flag di help/version ma si avvia come GUI, verifichiamo che non dia errori di segmentation fault o illegal instruction
            local test_out
            test_out=$(timeout 1s "$installed_bin" 2>&1 || true)
            if [[ "$test_out" =~ "Illegal instruction" ]] || [[ "$test_out" =~ "Segmentation fault" ]]; then
                test_failed=1
                test_err_msg="Errore durante il test di avvio del binario:\n$test_out"
            fi
        fi
    fi

    if [ "$test_failed" -ne 0 ]; then
        ui_error "Verifica Installazione Fallita" "Il programma è stato compilato ma il test finale ha riscontrato un problema:\n\n$test_err_msg"
        exit 1
    fi

    if [ "$IS_UPDATE" -eq 1 ]; then
        return 0
    fi

    if ui_ask_yesno "Installazione Riuscita" "$APP_NAME è stato verificato, compilato e installato con successo!\n\nVuoi avviare l'applicazione adesso?"; then
        "$user_bin/$APP_ID" >/dev/null 2>&1 &
    fi
}

main "$@"
